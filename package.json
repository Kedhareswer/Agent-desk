{
  "name": "agent-desk",
  "private": true,
  "version": "0.1.7",
  "description": "A lightweight background AI assistant for Windows that reuses your Claude or Codex subscription.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kedhareswer/Agent-desk"
  },
  "homepage": "https://github.com/Kedhareswer/Agent-desk",
  "bugs": "https://github.com/Kedhareswer/Agent-desk/issues",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.15.0",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "npm run test:rust && npm run test:ui",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "node tests/csp.test.mjs && node tests/ui.test.mjs",
    "lint": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets && node scripts/version.mjs --check",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "release:version": "node scripts/version.mjs",
    "package:manifests": "node scripts/packaging.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "playwright": "^1.65.1"
  }
}
