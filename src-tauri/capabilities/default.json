{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The notch: window basics, dragging, and the app's own commands",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-get-settings",
    "allow-save-settings",
    "allow-status",
    "allow-ask",
    "allow-stop",
    "allow-take-recovery",
    "allow-resume-task",
    "allow-dismiss-recovery",
    "allow-set-hit-regions",
    "allow-new-chat",
    "allow-hide",
    "allow-resize",
    "allow-focus",
    "allow-copy-text",
    "allow-insert-text",
    "allow-setup-info",
    "allow-list-models",
    "allow-download-speech",
    "allow-answer-action",
    "allow-list-schedules",
    "allow-save-schedule",
    "allow-delete-schedule",
    "allow-run-schedule-now"
  ]
}