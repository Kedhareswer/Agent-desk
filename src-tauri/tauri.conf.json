{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Desk",
  "version": "../package.json",
  "identifier": "com.agentdesk.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Desk",
        "width": 360,
        "height": 58,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "contentProtected": true,
        "focus": false
      },
      {
        "label": "glow",
        "title": "Agent Desk glow",
        "url": "glow.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "contentProtected": true,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Kedhareswer",
    "copyright": "Copyright (c) 2026 Agent Desk contributors. MIT License.",
    "category": "Productivity",
    "shortDescription": "Voice-first AI assistant that answers through your Claude or ChatGPT subscription.",
    "longDescription": "Hold Ctrl + Alt, speak, and let go. A small notch at the edge of the screen shows what Agent Desk is doing and grows into the answer. It uses the Claude Code or Codex CLI you are already signed in to.",
    "homepage": "https://github.com/Kedhareswer/Agent-desk",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDRThDMkU4M0QzOUEwMDcKUldRSG9Eazk2TUxvTEFFKzdWQnhBMU1qMHJxVDZPRGdOUmZaWXRZR21VeEh4dzhueVRubGpYc2wK",
      "endpoints": [
        "https://github.com/Kedhareswer/Agent-desk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
